# OpenAI Responses API
RIGEL_LLM_PROVIDER=openai
RIGEL_LLM_FORMAT=openai_responses
RIGEL_LLM_MODEL=gpt-5.2
OPENAI_API_KEY=sk-your-openai-key
# RIGEL_LLM_BASE_URL=https://api.openai.com/v1

# OpenAI Chat Completions API
# RIGEL_LLM_PROVIDER=openai
# RIGEL_LLM_FORMAT=openai_chat
# RIGEL_LLM_MODEL=gpt-5.2
# OPENAI_API_KEY=sk-your-openai-key
# RIGEL_LLM_BASE_URL=https://api.openai.com/v1

# Google Gemini 原生 generateContent 格式
# RIGEL_LLM_PROVIDER=google
# RIGEL_LLM_FORMAT=google_generate_content
# RIGEL_LLM_MODEL=gemini-3-flash-preview
# GEMINI_API_KEY=your-gemini-key
# RIGEL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 新增提供商：选择其兼容的接口格式，并配置 Key 与 Base URL
# RIGEL_LLM_PROVIDER=acme
# RIGEL_LLM_FORMAT=openai_chat
# RIGEL_LLM_MODEL=provider-model-name
# RIGEL_LLM_API_KEY=provider-api-key
# RIGEL_LLM_BASE_URL=https://provider.example/v1

# 可选生成参数
# RIGEL_LLM_TIMEOUT_SECONDS=60
# RIGEL_LLM_TEMPERATURE=0.2
# RIGEL_LLM_MAX_OUTPUT_TOKENS=2048
